<title>{{ quote.decedent }} — Quote</title>
<style>{{ css }}</style>

<section class="sheet">
  <h1 class="decedent">{{ quote.decedent }}</h1>
  {% if quote.header_line %}
  <p class="header-line">{{ quote.header_line }}</p>
  {% endif %}

  {% for option in quote.options %}
  <section class="option">
    <h2 class="option-title">{{ option.title }}</h2>
    {% if option.subtitle %}
    <p class="option-subtitle">{{ option.subtitle }}</p>
    {% endif %}

    <div class="option-body">
      <div class="photo-col">
        {% if option.image %}
        <img class="photo" src="{{ images[option.image] }}" alt="">
        {% if option.caption %}
        <p class="caption">{{ option.caption }}</p>
        {% endif %}
        {% endif %}
      </div>

      <table class="prices">
        {% for line in option.lines %}
        <tr>
          <td class="desc">{{ line.label }}</td>
          <td class="amount">{{ line.extended | money }}</td>
        </tr>
        {% endfor %}
        {% if quote.apply_tax_to_totals %}
        <tr>
          <td class="desc">Sales Tax ({{ tax_percent }}, merchandise only)</td>
          <td class="amount">{{ option.tax(quote.tax_rate) | money }}</td>
        </tr>
        {% endif %}
        <tr class="total">
          <td class="desc">Estimated Total</td>
          <td class="amount">
            {{ (option.total_with_tax(quote.tax_rate) if quote.apply_tax_to_totals else option.total) | money }}
          </td>
        </tr>
      </table>
    </div>
  </section>
  {% endfor %}

  {% if quote.footnotes %}
  <div class="footnotes">
    {% for note in quote.footnotes %}
    <p>{{ note }}</p>
    {% endfor %}
  </div>
  {% endif %}
</section>

{% if quote.financing %}
<section class="sheet page-break pay">
  <h1 class="decedent">{{ quote.decedent }}</h1>
  <p class="header-line">Payment Options</p>

  <h2 class="option-title down-heading">Down Payment</h2>
  <div class="callout">{{ quote.financing.down_payment_note }}</div>

  {# With a per-option breakdown below, these summary cards would just repeat
     the same plans, so they are shown only when there is no breakdown. #}
  {% if quote.financing.plans and not schedules %}
  <h2 class="option-title plans-heading">Financing Plans</h2>
  <div class="plans">
    {% for plan in quote.financing.plans %}
    <div class="plan">
      <div class="plan-head">
        <span class="plan-label">{{ plan.label }}</span>
        <span class="plan-rate">{{ plan.display_rate }}</span>
      </div>
      {% if plan.description %}
      <p class="plan-description">{{ plan.description }}</p>
      {% endif %}
    </div>
    {% endfor %}
  </div>
  {% endif %}

  {% if schedules %}
  {% for option, rows in schedules %}
  <h2 class="option-title plans-heading">{{ option.title }}</h2>
  <p class="option-subtitle">
    {% if option.total.is_range %}
    Figured on the low end of this option's estimated total, {{ option.total | money }}.
    {% else %}
    Figured on this option's total of {{ option.total | money }}.
    {% endif %}
  </p>

  {% for row in rows %}
  <div class="breakdown">
    <div class="plan-head">
      <span class="plan-label">{{ row.plan.label }}</span>
      <span class="plan-rate">{{ row.plan.display_rate }}</span>
    </div>
    <table class="ledger">
      <tr>
        <td class="desc">Down payment</td>
        <td class="amount">${{ '{:,.2f}'.format(row.down) }}</td>
        <td class="when">
          due at signing{% if quote.financing.signing_date %},
          {{ quote.financing.signing_date.strftime('%b %-d, %Y') }}{% endif %}
        </td>
      </tr>
      <tr>
        <td class="desc">Amount financed</td>
        <td class="amount">${{ '{:,.2f}'.format(row.financed) }}</td>
        <td class="when"></td>
      </tr>
      {% if row.quote %}
      <tr>
        <td class="desc">{{ row.quote.level_count }} monthly payment{{ '' if row.quote.level_count == 1 else 's' }} of</td>
        <td class="amount">${{ '{:,.2f}'.format(row.quote.monthly) }}</td>
        <td class="when">
          {% if row.quote.first_payment %}
          {{ row.quote.first_payment.strftime('%b %-d, %Y') }}{% if row.quote.level_count > 1 %} – {{ row.quote.last_level_payment.strftime('%b %-d, %Y') }}{% endif %}
          {% endif %}
        </td>
      </tr>
      {% if row.quote.has_adjusted_final %}
      <tr>
        <td class="desc">Final payment</td>
        <td class="amount">${{ '{:,.2f}'.format(row.quote.final_monthly) }}</td>
        <td class="when">
          {% if row.quote.final_payment %}{{ row.quote.final_payment.strftime('%b %-d, %Y') }} — {% endif %}adjusted to clear the balance
        </td>
      </tr>
      {% endif %}
      <tr class="ledger-total">
        <td class="desc">Total of payments</td>
        <td class="amount">${{ '{:,.2f}'.format(row.quote.total_of_payments) }}</td>
        <td class="when">
          {% if row.quote.finance_charge > 0 %}includes ${{ '{:,.2f}'.format(row.quote.finance_charge) }} in finance charges{% else %}no finance charge{% endif %}{% if row.quote.final_payment %}, paid in full {{ row.quote.final_payment.strftime('%b %-d, %Y') }}{% endif %}
        </td>
      </tr>
      {% else %}
      <tr class="ledger-total">
        <td class="desc">{{ row.plan.months }} monthly payments of</td>
        <td class="amount quoted-later">rate set at signing</td>
        <td class="when">first payment one month after signing</td>
      </tr>
      {% endif %}
    </table>
  </div>
  {% endfor %}
  {% endfor %}
  {% endif %}

  {% if quote.financing.notes %}
  <div class="notes">
    {% for note in quote.financing.notes %}
    <p>{{ note }}</p>
    {% endfor %}
  </div>
  {% endif %}
</section>
{% endif %}
